[Unit]
Description=JOMLA closed pilot MongoDB-backed worker - reviewed template only
Requires=mongod.service
After=network.target mongod.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=jomla-pilot
Group=jomla-pilot
WorkingDirectory=/srv/jomla-pilot
EnvironmentFile=/etc/jomla-pilot/runtime.env
ExecStart=/usr/bin/flock --shared --nonblock --no-fork /run/jomla-pilot/generation.lock /usr/bin/flock --exclusive --nonblock --no-fork /run/jomla-pilot/worker.lock /usr/bin/node /srv/jomla-pilot/launcher/launch.cjs worker
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/jomla-pilot/uploads
ReadWritePaths=/var/log/jomla-pilot/runtime /run/jomla-pilot
InaccessiblePaths=-/etc/jomla-pilot-tls
CapabilityBoundingSet=
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
# Only local MongoDB and files are required by the initial manual/visual scope.
IPAccounting=true
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
