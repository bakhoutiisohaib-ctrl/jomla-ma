# TEMPLATE ONLY. Copy through the operator's approved secret-management process.
# Intended destination: /etc/jomla-pilot/runtime.env, root-owned mode0600.
# systemd reads EnvironmentFile; do not source this file as a shell script.
# Do not create backend/.env in the immutable release and do not copy an old .env.
NODE_ENV=production
# Initial8GiB planning assumption: per-process V8 old-generation heap only.
# This does NOT cap RSS, Buffers, sharp/libvips native memory or all allocations.
NODE_OPTIONS=--max-old-space-size=512
PORT=5000
CORS_ORIGIN=https://pilot.example.invalid
TRUST_PROXY=1
MONGODB_URI=mongodb://jomla_pilot_app:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:27017/jomla_pilot?authSource=jomla_pilot
JWT_SECRET=REPLACE_WITH_A_FRESH_RANDOM_SECRET_NOT_A_REAL_VALUE
UPLOADS_DIR=/var/lib/jomla-pilot/uploads
LOG_DIR=/var/log/jomla-pilot/runtime
LOG_LEVEL=info
DISABLE_REDIS=1
JOB_WORKER_MODE=external
JOB_CONCURRENCY=1
JOB_LEASE_MS=30000
JOB_POLL_MS=1000
JOB_SHUTDOWN_GRACE_MS=15000
VISUAL_SEARCH_MIN_SCORE=0.82
VISUAL_SEARCH_MAX_CANDIDATES=5000
# AI is explicitly outside the initial manual pilot scope. Caddy blocks enhance
# and API/worker egress is also limited to localhost by the service templates.
CLAUDE_API_KEY=
CLAUDE_MODEL=
GOOGLE_VISION_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
EXTERNAL_DISCOVERY_ENABLED=false
EXTERNAL_DISCOVERY_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
EXTERNAL_DISCOVERY_TERMS_ACCEPTED=false
EXTERNAL_DISCOVERY_TERMS_REFERENCE=
