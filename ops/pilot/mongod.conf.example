# For a NEW dedicated pilot MongoDB installation only. Do not overwrite a
# configuration used by any existing project database.
# Account bootstrap and role assignment are separate privileged operator steps.
storage:
  dbPath: /var/lib/mongodb
  # Initial8GiB planning assumption only. Measure actual Mongo/Node/native RSS.
  wiredTiger:
    engineConfig:
      cacheSizeGB: 1
systemLog:
  destination: file
  path: /var/log/mongodb/mongod.log
  logAppend: true
net:
  bindIp: 127.0.0.1
  port: 27017
  unixDomainSocket:
    enabled: false
security:
  authorization: enabled
