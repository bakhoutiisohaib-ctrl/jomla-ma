# Backend local configuration. Copy to .env and supply your own values.
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5001
TRUST_PROXY=0
MONGODB_URI=mongodb://127.0.0.1:27017/jomla-ma
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters
DISABLE_REDIS=1
REDIS_URL=redis://127.0.0.1:6379
LOG_LEVEL=info
LOG_DIR=logs
# Optional AI. Missing provider leaves manual product entry available.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
# Optional external discovery: do not enable before reviewing provider terms.
EXTERNAL_DISCOVERY_ENABLED=false
EXTERNAL_DISCOVERY_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
EXTERNAL_DISCOVERY_TERMS_ACCEPTED=false
EXTERNAL_DISCOVERY_TERMS_REFERENCE=
# Product images use a persistent backend/uploads volume. Keep private
# verification documents in a separate private/signed HTTPS storage service.
# Optional absolute path to an existing persistent volume, shared by API/worker.
UPLOADS_DIR=
# embedded starts the Mongo-backed worker with npm start. For a separate process
# use external here and run npm run worker on the same DB/storage configuration.
JOB_WORKER_MODE=embedded
JOB_CONCURRENCY=2
JOB_LEASE_MS=30000
JOB_POLL_MS=1000
VISUAL_SEARCH_MIN_SCORE=0.82
VISUAL_SEARCH_MAX_CANDIDATES=5000
