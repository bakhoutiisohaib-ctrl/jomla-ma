# Environment example for Jomla.ma backend
# Copy to .env and fill values

# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/jomla-ma

# JWT
JWT_SECRET=replace_with_a_strong_secret

# Redis (optional)
REDIS_URL=redis://127.0.0.1:6379

# Cloudinary (for product image upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Anthropic / Claude
CLAUDE_API_KEY=your_claude_api_key

# Google Vision
GOOGLE_VISION_KEY=your_google_vision_key
# Database
MONGODB_URI=mongodb://127.0.0.1:27017/jomla-ma

# Server
PORT=5000
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5001

# JWT
JWT_SECRET=your-super-secret-key-change-this-in-production

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# Cloudinary (للصور)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Vision API (للبحث بالصور)
GOOGLE_VISION_KEY=your_google_vision_key

# Anthropic Claude API (للبحث الذكي و AI)
CLAUDE_API_KEY=your_claude_api_key
